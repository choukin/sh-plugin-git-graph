{
  "name": "dsh-plugin-git-graph",
  "version": "0.2.1",
  "private": false,
  "license": "MIT",
  "description": "在 DeepSeek Harness 右侧栏浏览当前项目的 Git 提交图谱，并在输入框旁直接切换分支：多泳道连线、HEAD / 分支 / 标签 / 远程徽标、提交详情与单文件 diff",
  "author": "choukin <choukin@dingtalk.com> (https://github.com/choukin)",
  "contributors": [
    {
      "name": "choukin",
      "email": "zx2009428@163.com"
    }
  ],
  "homepage": "https://github.com/choukin/sh-plugin-git-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choukin/sh-plugin-git-graph.git"
  },
  "bugs": {
    "url": "https://github.com/choukin/sh-plugin-git-graph/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/screenshots/*.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "git",
    "git-graph",
    "git-log",
    "vscode-git-graph"
  ],
  "scripts": {
    "check": "node --check lib/git.js && node --check lib/index.js && node --check client.js",
    "test": "node --test 'test/*.spec.mjs'"
  }
}
